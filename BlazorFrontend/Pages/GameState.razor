@page "/gameState"
@using BlazorFrontend.Pages.Accounts
@using Microsoft.AspNetCore.Authorization
@using Shared.State
@attribute [Authorize]
@inject HttpClient Http
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage
@inject CustomAuthStateProvider CustomAuthStateProvider

<h3>GameState</h3>

@if (gameState is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <p><em>@gameState.Type</em></p>

    @switch (gameState.Context)
    {
        case QuestChoiceContextDto questChoice:
            <p>state: questChoice</p>
            <p>@questChoice.Test1</p>
            break;
        case CombatContextDto combat:
            <p>state: combat</p>
            <p>@combat.Test2</p>
            break;
        case QuestResultContextDto result:
            <p>state: result</p>
            <p>@result.Test3</p>
            break;
        default:
            <p>Nieznany stan gry</p>
            break;
    }

    @if (@gameState.DecisionSlots.Count > decisionRequest.ChosenActions.Count)
    {
        <p>@gameState.DecisionSlots[decisionRequest.ChosenActions.Count].Id</p>
        <p>@gameState.DecisionSlots[decisionRequest.ChosenActions.Count].Description</p>
        @foreach (var d in @gameState.DecisionSlots[decisionRequest.ChosenActions.Count].AvailableActions)
        {
            <p>
                <button class="btn btn-primary" @onclick="() => Decision(d.Id)">@d.Id - @d.Description</button>
            </p>
        }
    }
}

@code {

    private GameStateDto? gameState;
    private DecisionRequestDto decisionRequest = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await CustomAuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        bool isLoggedIn = user.Identity?.IsAuthenticated ?? false;
        if (isLoggedIn)
        {
            var response = await Http.GetFromJsonAsync<GameStateDto>("api/gameState/gameState");
            gameState = response;
            decisionRequest = new();
        }
    }

    private async Task Decision(Guid decision)
    {
        Guid slot = gameState.DecisionSlots[decisionRequest.ChosenActions.Count].Id;

        decisionRequest.ChosenActions.Add(slot, decision);

        if (decisionRequest.ChosenActions.Count == gameState.DecisionSlots.Count)
        {
            var response = await Http.PostAsJsonAsync("api/gameState/decision", decisionRequest);

            if (response.IsSuccessStatusCode)
            {
                var newState = await response.Content.ReadFromJsonAsync<GameStateDto>();
                gameState = newState;
                decisionRequest = new();
            }
        }
    }
}
